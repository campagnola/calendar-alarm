<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Event header ─────────────────────────────────── -->

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/detailTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/detailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailJoinButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- ── Description ──────────────────────────────────── -->

        <TextView
            android:id="@+id/detailDescriptionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- ── Organizer ─────────────────────────────────────── -->

        <TextView
            android:id="@+id/detailOrganizerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Organizer"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detailOrganizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- ── Attendees ──────────────────────────────────────── -->

        <TextView
            android:id="@+id/detailAttendeesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attendees"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/detailAttendeesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ── Divider ────────────────────────────────────────── -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorControlHighlight"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="14dp" />

        <!-- ── Filters section ───────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filters"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/filterMatchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ── Add filter button ─────────────────────────────── -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addFilterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add filter for this event"
            android:layout_marginTop="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- ── Alarm preferences ────────────────────────────── -->

        <TextView
            android:id="@+id/alarmPreferenceHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alarm"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/alarmPreferenceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/disableEventAlarmButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable alarm for this event"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/disableSeriesAlarmButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable alarm for all events in the series"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enableEventAlarmButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable alarm for this event"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enableSeriesAlarmButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable alarm for all events in the series"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- ── Advance warning ───────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reminder"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/advanceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Minutes before start"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/advanceInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveAdvanceButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Set" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetAdvanceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use filter / default reminder"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- ── Filter creation panel ─────────────────────────── -->

        <LinearLayout
            android:id="@+id/filterCreatePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add criteria for:"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/filterCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createFilterButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create filter"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
